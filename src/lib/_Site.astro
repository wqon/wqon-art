---
import "./global.css";
import "./fontface.css";
import Head from "../components/Head.astro";
import Header from "../components/header/_Header.astro";
import Logotype from "../components/header/Logotype.astro";
import Promo from "../components/header/Promo.astro";
import Footer from "../components/Footer.astro";
import Loader from "../components/Loader.astro";
import Cursor from "../components/Cursor.astro";
import Border from "../components/Border.astro";

const { title, description, theme, canon, ogTitle, ogDescription, ogImage } =
    Astro.props;
---

<!doctype html>
<!-- Designed & developed with <3 by WQON using human intelligence. -->
<!---->
<!-- For technical details, see https://github.com/wqon/wqon-art. -->
<html lang="en">
    <Head
        title={title}
        description={description}
        theme={theme}
        canon={canon}
        ogTitle={ogTitle}
        ogDescription={ogDescription}
        ogImage={ogImage}
    />
    <body>
        <main>
            <div class="mobile">
                <div class="wrapper">
                    <Header />
                    <div class="content">
                        <slot />
                    </div>
                </div>
                <Footer />
            </div>
        </main>
        <main>
            <div class="desktop">
                <div class="wrapper">
                    <Header />
                    <div class="content">
                        <div class="bar">
                            <Logotype />
                            <Promo />
                        </div>
                        <slot />
                    </div>
                </div>
                <Footer />
            </div>
        </main>
        <Loader />
        <Cursor />
        <Border />
    </body>
</html>

<style>
    .content {
        background: var(--passive);
        color: var(--dark);
    }

    /* -------- Z -------- */
    :global(.border) {
        z-index: 256;
    }
    :global(.cursor) {
        z-index: 128;
    }
    :global(footer) {
        z-index: 64;
    }
    :global(.pocket-border) {
        z-index: 32;
    }
    .wrapper {
        z-index: 1;
    }

    @media /* mobile */ (width <= 768px) {
        .desktop {
            display: none;
        }

        .mobile {
            display: flex;
            flex-direction: column;
            border: var(--border);
        }
        .wrapper {
            min-height: 100svh;
            display: flex;
            flex-direction: column;
        }
        .content {
            flex: 1;
        }
    }

    @media /* desktop */ (width > 768px) {
        .mobile {
            display: none;
        }

        .desktop {
            display: flex;
            flex-direction: column;
            border: var(--border);
        }
        .wrapper {
            min-height: 100svh;
            display: flex;
            flex-direction: row;
        }
        .bar {
            height: var(--headergap);
            position: sticky;
            top: 1px;
            display: grid;
            grid-template: auto / auto 1fr;
        }
        :global(#Logotype) {
            padding: 0 var(--16);
        }
        .content {
            flex: 1;
        }
    }
</style>
