---
import config from "../config.json";
import Newsletter from "../components/footer/Newsletter.astro";
import Socials from "../components/footer/Socials.astro";
import Up from "../components/footer/Up.astro";

const year = () => new Date().getFullYear();
---

<footer>
    <Newsletter />
    <div class="copyright">
        <span>Copyright © 2020-{year} WQON.</span>
        <span>All rights reserved.</span>
    </div>
    <nav class="menu">
        {config.menu.footer.map(
            (link) =>
                link.active && (
                    <a
                        class={
                            Astro.url.pathname === link.href
                                ? "pageActive"
                                : undefined
                        }
                        href={
                            Astro.url.pathname === link.href
                                ? undefined
                                : link.href
                        }
                        target={link.blank ? "_blank" : "_self"}
                        data-cursor={
                            Astro.url.pathname === link.href
                                ? undefined
                                : "pointer"
                        }
                    >
                        <span>{link.title}</span>
                    </a>
                ),
        )}
    </nav>
    <Socials />
    <Up />
</footer>

<style>
    footer {
        background: var(--passive);
        padding: var(--sitegap);
        margin-top: -1px;
    }
</style>
