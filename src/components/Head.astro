---
import config from "../config.json";

const { title, description, theme, canon, ogTitle, ogDescription, ogImage } =
    Astro.props;
---

<head>
    <meta charset="utf-8" />
    <title>{config.title ?? `${title} - WQON`}</title>
    <meta name="description" content={config.description ?? description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Lukáš Nox / WQON" />
    <meta name="theme-color" content={config.theme ?? theme} />
    <meta name="color-scheme" content="dark light" />
    <meta name="canonical" content={config.canon ?? canon} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={config.og.title ?? ogTitle} />
    <meta
        property="og:description"
        content={config.og.description ?? ogDescription}
    />
    <meta property="og:url" content={config.canon ?? canon} />
    <meta property="og:image" content={config.og.image ?? ogImage} />

    <link
        rel="icon"
        type="image/png"
        href="/favicon-96x96.png?v=20261120"
        sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261120" />
    <link rel="shortcut icon" href="/favicon.ico?v=20261120" />
    <link
        rel="apple-touch-icon"
        sizes="180x180"
        href="/apple-touch-icon.png?v=20261120"
    />
    <meta name="apple-mobile-web-app-title" content="WQON" />
    <link rel="manifest" href="/site.webmanifest?v=20261120" />

    <script src="../lib/jsReady.js" />
    <script src="../lib/killHash.js" />
    <script src="../lib/noDrag.js" />
    <script src="../lib/localStorage.js" />
</head>
