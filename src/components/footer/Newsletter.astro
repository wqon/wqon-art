<aside id="Newsletter">
    <div>
        <h3>W’s Club</h3>
        <p>
            Join my newsletter to get news about font releases,
            behind-the-scenes from my work, occasional promo codes nad tips.
        </p>
    </div>
    <form id="formSubscribe" action="/subscribe" method="POST">
        <>
            <input type="hidden" name="tag" value="form" />
            <input type="hidden" name="timestamp" value={Date.now()} />
            <input
                type="email"
                name="email"
                placeholder="Email Address"
                autocomplete="email"
                required
                data-cursor="text"
            />
            <input
                class="website"
                type="text"
                name="website"
                autocomplete="off"
            />
        </>
        <>
            <button class="submit" type="submit" data-cursor="pointer">
                ENTER
            </button>
        </>
    </form>
    <span id="subscribed">Thank you for joining! ❤</span>
    <span class="s">
        By subscribing to my newsletter, you agree to the{" "}
        <a href="/terms" data-cursor="pointer">
            Terms
        </a>
        .
    </span>
</aside>

<style>
    #Newsletter {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        background: var(--light);
        color: var(--black);
        padding: var(--headergap);
    }

    form {
        height: calc(var(--headergap) / 1.25);
        display: flex;
        flex-direction: row;
        gap: var(--4);
        margin-top: calc(var(--gap) * 2);
    }
    input:not(.website) {
        flex: 2;
    }
    button {
        flex: 1;
    }

    .website {
        width: 1px;
        height: 1px;
        position: absolute;
        translate: -65536px 0;
        overflow: hidden;
    }

    #subscribed {
        display: none;
    }
    #subscribed:target {
        height: calc(var(--headergap) / 1.25);
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: var(--white);
        outline: var(--4) solid var(--white);
        border-radius: var(--r);
        margin-top: calc(var(--gap) * 2);
    }
    #Newsletter:has(#subscribed:target) form {
        display: none;
    }

    @media /* desktop */ (width > 768px) {
        form,
        #subscribed {
            max-width: calc(var(--headergap) * 8);
        }
    }
</style>

<script is:inline>
    document
        .querySelector("#formSubscribe")
        .addEventListener("submit", async (e) => {
            e.preventDefault();

            const form = e.target;
            const formData = new FormData(form);

            const res = await fetch(form.action, {
                method: "POST",
                body: formData,
            });

            const data = await res.json();

            if (res.ok) {
                window.location.hash = "subscribed";
            } else {
                const title = data.error?.title || "Error.";
                const detail = data.error?.detail || "Something went wrong.";

                alert(`${title}\n${detail}`);
            }
        });
</script>
