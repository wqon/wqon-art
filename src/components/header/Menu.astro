---
import config from "../../config.json";
---

<nav id="Menu" class="wrapper">
    <div class="menu">
        {config.menu.header.map(
            (link) =>
                link.active && (
                    <a
                        class={
                            Astro.url.pathname === link.href
                                ? "pageActive"
                                : undefined
                        }
                        href={
                            Astro.url.pathname === link.href
                                ? undefined
                                : link.href
                        }
                        target={link.blank ? "_blank" : "_self"}
                        data-cursor={
                            Astro.url.pathname === link.href
                                ? undefined
                                : "pointer"
                        }
                    >
                        <span>{link.title}</span>
                    </a>
                ),
        )}

        <label class="plus" data-cursor="pointer">
            <input class="toggle" type="checkbox" />
            <div class="icon" />
        </label>

        <div class="plus-menu">
            {config.menu.plus.map(
                (link) =>
                    link.active && (
                        <a
                            class={
                                Astro.url.pathname === link.href
                                    ? "pageActive"
                                    : undefined
                            }
                            href={
                                Astro.url.pathname === link.href
                                    ? undefined
                                    : link.href
                            }
                            target={link.blank ? "_blank" : "_self"}
                            data-cursor={
                                Astro.url.pathname === link.href
                                    ? undefined
                                    : "pointer"
                            }
                        >
                            <span>{link.title}</span>
                        </a>
                    ),
            )}
        </div>
    </div>
</nav>

<style>
    .wrapper {
        position: relative;
    }

    .menu {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: var(--passive);
    }

    a {
        flex: auto;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: "Mellow Void";
        font-size: var(--l);
        writing-mode: vertical-lr;
        border-top: var(--border);
    }
    a:last-of-type {
        border-bottom: var(--border);
    }
    a,
    a:hover,
    .pageActive {
        color: var(--black);
    }
    a:hover,
    .pageActive,
    .menu:has(.plus-menu a.pageActive) .plus {
        background: var(--light);
        font-family: "Mellow";
    }
    a:active span {
        transform: var(--negscale);
    }
    .pageActive {
        cursor: default;
    }
    .pageActive:active span {
        transform: none;
    }

    .toggle {
        display: none;
    }

    .plus,
    .icon {
        cursor: pointer;
    }
    .plus {
        position: relative;
        display: block;
        width: max-content;
        aspect-ratio: 1;
        background: var(--passive);
        padding: var(--logopad);
    }
    .icon {
        width: 7px;
        aspect-ratio: 1;
        mask-image: url("/assets/plus.png");
        mask-size: 7px 77px;
        mask-position: 0px 0px;
        mask-repeat: no-repeat;
        image-rendering: pixelated;
        zoom: var(--logozoom);
        background: var(--black);
    }
    .toggle:checked ~ .icon {
        animation: 300ms steps(3, end) forwards toPlusX;
    }
    @keyframes toPlusX {
        from {
            mask-position: 0px -14px;
        }
        to {
            mask-position: 0px -35px;
        }
    }
    .toggle:not(:checked) ~ .icon {
        animation: 500ms steps(5, end) forwards toPlus;
    }
    @keyframes toPlus {
        from {
            mask-position: 0px -35px;
        }
        to {
            mask-position: 0px -70px;
        }
    }
    .plus:hover .toggle:not(:checked) ~ .icon {
        animation: 200ms steps(2, end) forwards toPlusArrow;
    }
    @keyframes toPlusArrow {
        from {
            mask-position: 0px 0px;
        }
        to {
            mask-position: 0px -14px;
        }
    }
    .icon:active {
        transform: var(--scale);
    }

    .plus-menu {
        width: calc(var(--headergap) + 1px);
        height: 100%;
        position: absolute;
        bottom: var(--headergap);
        display: flex;
        flex-direction: column;
        background: var(--passive);
        border-right: var(--border);
        padding-top: var(--headergap);
        visibility: hidden;
        translate: -101% 0;
        transition:
            translate 200ms ease-out,
            visibility 0ms 200ms allow-discrete;
    }
    .plus:has(.toggle:checked) ~ .plus-menu {
        visibility: visible;
        translate: 0 0;
        transition:
            translate 200ms ease-out,
            visibility 0ms allow-discrete;
    }
</style>

<script></script>
