---
import Logo from "./Logo.astro";
import Promo from "./Promo.astro";
import PocketMenu from "./PocketMenu.astro";
import Menu from "./Menu.astro";
---

<header class="mobile">
    <Logo />
    <Promo />
    <PocketMenu />
</header>

<header class="desktop">
    <Logo />
    <Menu />
</header>

<style>
    .mobile,
    .desktop,
    :global(.bar) {
        user-select: none;
    }

    @media /* mobile */ (width <= 768px) {
        .desktop {
            display: none;
        }

        .mobile {
            position: sticky;
            top: 0px;
            display: grid;
            grid-template: var(--headergap) / auto 1fr auto;
        }
    }

    @media /* desktop */ (width > 768px) {
        .mobile {
            display: none;
        }

        .desktop {
            height: 100svh;
            position: sticky;
            top: 0px;
            bottom: 1px;
            display: grid;
            grid-template: auto 1fr / var(--headergap);
        }
    }
</style>
